SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
OPENAI_API_KEY=sk-your-openai-key

# OAuth (required for public distribution)
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_STATE_SECRET=any-random-secret-string

# Optional: seed a workspace token without OAuth (backward compat)
SLACK_TEAM_ID=T0000000000

# Socket Mode (for local dev only — not used on Vercel)
SLACK_APP_TOKEN=xapp-your-app-token

# Demo mode: instant responses, no OpenAI API calls
DEMO_MODE=true

# Port (local only)
PORT=3000
MCP_PORT=3001
